{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motio",
  "version": "0.6.0",
  "identifier": "com.flowitup.motio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Motio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/motio-engine/": "motio-engine/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/flowitup/motio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDOTcxNTYyMkE5M0RFQTkKUldTcDNwTXFZaFdYVEptcnJ0Slh3SGNsaElaeWVhNy92dENFMVE0OTAwUTNra3Z2ckZ5WUVtSEcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
