# Copy to /opt/motio/.env on the server (cp env.example .env) and fill in. Never commit the real file.
# Tạo chuỗi bí mật: openssl rand -hex 32   (dùng hex, không dùng ký tự đặc biệt vì nằm trong URL Postgres)

# ---------- Tên miền (bản ghi A/AAAA trỏ về IP server trước khi chạy) ----------
MOTIO_DOMAIN=motio.example.com
POSTIZ_DOMAIN=postiz.example.com

# ---------- Engine Motio ----------
# Token cho app desktop (Cài đặt → "Engine từ xa") và mọi lời gọi /api.
MOTIO_TOKEN=
# Deploy workflow tự ghi dòng này (ảnh theo commit). Để trống = :latest.
MOTIO_IMAGE=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model ID đầy đủ khi LLM_PROVIDER=anthropic (trống = mặc định trong motio/llm.py)
ANTHROPIC_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# faster-whisper trên CPU; large-v3-turbo là mặc định
WHISPER_MODEL=
NEWSNOW_URL=
NEWS_SOURCES=
MAX_VIDEOS_PER_DAY=
CREDIT_ON_VIDEO=
CREDIT_IN_POST=
# Các key trên cũng đổi được trong app (Cài đặt), lưu ở data/settings.json và đè lên file này.

# ---------- Postiz ----------
POSTIZ_VERSION=v2.24.0
POSTIZ_JWT_SECRET=
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
# true = chỉ tài khoản đầu tiên được đăng ký
POSTIZ_DISABLE_REGISTRATION=true
POSTIZ_API_LIMIT=90
# Postiz → Settings → Developers → Public API. Engine dùng key này để gửi video sang Postiz.
POSTIZ_API_KEY=

# App developer của từng mạng xã hội (callback: https://$POSTIZ_DOMAIN/integrations/social/<provider>)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
X_API_KEY=
X_API_SECRET=
