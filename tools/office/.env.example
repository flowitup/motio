# Token the hook sends (put the same value in the Motio cloud environment as OFFICE_TOKEN)
OFFICE_TOKEN=change-me-long-random
# Token for the browser: open https://office.example.com/?key=<VIEW_TOKEN>
VIEW_TOKEN=change-me-too
# Optional: secret of the GitHub webhook (pull_request + pull_request_review events)
GITHUB_WEBHOOK_SECRET=
